{
  "git.autofetch": true,
  "git.autofetchPeriod": 180,
  "git.confirmSync": true,
  "git.enableSmartCommit": false,
  "git.suggestSmartCommit": false,
  "editor.formatOnSave": false,
  "files.trimTrailingWhitespace": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/.DS_Store": true,
    "**/__pycache__": true
  }
}
